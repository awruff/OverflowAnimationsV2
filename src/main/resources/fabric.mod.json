{
	"schemaVersion": 1,
	"id": "overflowanimations",
	"version": "${version}",
	"name": "OverflowAnimations",
	"description": "1.7 animations for Minecraft 1.8.9.",
	"authors": [
		"Mixces",
		"lowercasebtw"
	],
	"contributors": [
		"Tellinq",
		"MicrocontrollersDev",
		"Wyvest"
	],
	"contact": {
		"sources": "https://github.com/Polyfrost/OverflowAnimationsV2",
		"issues": "https://github.com/Polyfrost/OverflowAnimationsV2/issues"
	},
	"license": "GPL-3.0-with-linking-exception",
	"icon": "assets/overflowanimations/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"adapter": "kotlin",
				"value": "org.polyfrost.overflowanimations.OverflowAnimationsLegacy"
			}
		]
	},
	"mixins": [
		"overflowanimations.mixins.json"
	],
	"provides": ["animatium"],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"fabric-language-kotlin": "*",
		"oneconfigv1": ">=1.4.0"
	}
}
